# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this app is hosted on Hostinger:
APP_URL="https://www.purposetalk.site"
PORT=3000
# Optional comma-separated origins allowed for CORS (apex + www):
CORS_ORIGINS="https://www.purposetalk.site,https://purposetalk.site"

# --- Payment Gateway Configuration (Server-Side Only, Never Expose Secrets to Client) ---
# Recommended for Brazil (PIX + Cards + 7-day free trial via Preapproval API):
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
VITE_MERCADOPAGO_PUBLIC_KEY=""

# Optional Global Alternative (Cards in BRL/USD + 7-day trial):
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Firebase Cloud Messaging (Web Push Notifications) ---
# Public Web Push certificate (VAPID) key from Firebase Console -> Project Settings -> Cloud Messaging:
VITE_FIREBASE_VAPID_KEY=""
# Optional server-side FCM key for automated backend streak-at-risk reminders:
FCM_SERVER_KEY=""

# --- Google Play Store & TWA Digital Asset Links ---
# Direct Google Play Store listing URL once published (defaults to https://play.google.com/store/apps/details?id=app.purposetalk.twa):
VITE_GOOGLE_PLAY_URL=""
VITE_ANDROID_PACKAGE_NAME="app.purposetalk.twa"
ANDROID_PACKAGE_NAME="app.purposetalk.twa"
# Comma-separated SHA-256 fingerprint(s) from Google Play Console -> App Integrity -> App Signing:
ANDROID_SHA256_FINGERPRINTS=""

